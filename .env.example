# Default offline/demo mode. No paid API is required for deterministic benchmark cases.
BENCHMIND_MODEL_PROVIDER=mock

# To enable real image reasoning, switch provider and add an OpenAI API key.
# BENCHMIND_MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
BENCHMIND_OPENAI_MODEL=gpt-5.6-luna

BENCHMIND_ENVIRONMENT=development
BENCHMIND_DATA_DIR=.benchmind
BENCHMIND_MAX_UPLOAD_BYTES=10485760
BENCHMIND_MAX_FILES_PER_CASE=12
BENCHMIND_CORS_ORIGINS=http://localhost:3000
BENCHMIND_REQUEST_TIMEOUT_SECONDS=45
BENCHMIND_MAX_PARALLEL_AGENTS=4

NEXT_PUBLIC_BENCHMIND_API=http://localhost:8000
